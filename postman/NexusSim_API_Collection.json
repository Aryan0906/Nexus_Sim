{
  "info": {
    "name": "NexusSim API",
    "description": "Full-stack API collection for NexusSim. Import into Postman (File > Import) and run top to bottom. All services must be running (run_full_system.bat or the individual launchers). Verified 2026-10-20: 24/24 endpoints pass.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gw", "value": "http://localhost:8000" },
    { "key": "engine", "value": "http://localhost:9001" },
    { "key": "camera", "value": "http://localhost:9003" },
    { "key": "nlp", "value": "http://localhost:9004" },
    { "key": "eventbus", "value": "http://localhost:9005" },
    { "key": "algo", "value": "http://localhost:9006" },
    { "key": "dashboard", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "1. Gateway (:8000)",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{gw}}/api/health", "host": ["{{gw}}"], "path": ["api", "health"] }
          }
        },
        {
          "name": "POST /api/chat",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"what is the average wait time\",\n  \"city\": \"chicago\"\n}" },
            "url": { "raw": "{{gw}}/api/chat", "host": ["{{gw}}"], "path": ["api", "chat"] }
          }
        },
        {
          "name": "POST /api/incident",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"accident on main street\",\n  \"city\": \"chicago\"\n}" },
            "url": { "raw": "{{gw}}/api/incident", "host": ["{{gw}}"], "path": ["api", "incident"] }
          }
        },
        {
          "name": "GET /api/camera/feed",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{gw}}/api/camera/feed", "host": ["{{gw}}"], "path": ["api", "camera", "feed"] }
          }
        },
        {
          "name": "GET /api/algo (48-algorithm catalog)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{gw}}/api/algo", "host": ["{{gw}}"], "path": ["api", "algo"] }
          }
        },
        {
          "name": "POST /api/events/publish/cv.anomaly",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"test anomaly\",\n  \"severity\": \"low\"\n}" },
            "url": { "raw": "{{gw}}/api/events/publish/cv.anomaly", "host": ["{{gw}}"], "path": ["api", "events", "publish", "cv.anomaly"] }
          }
        },
        {
          "name": "WS /ws (engine state stream)",
          "request": {
            "method": "GET",
            "header": [],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"city\",\n  \"city\": \"chicago\"\n}" },
            "url": { "raw": "ws://localhost:8000/ws", "protocol": "ws", "host": ["localhost"], "port": "8000", "path": ["ws"] }
          }
        },
        {
          "name": "WS /ws/events (event bus stream)",
          "request": {
            "method": "GET",
            "header": [],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"subscribe\",\n  \"topic\": \"cv.anomaly\"\n}" },
            "url": { "raw": "ws://localhost:8000/ws/events", "protocol": "ws", "host": ["localhost"], "port": "8000", "path": ["ws", "events"] }
          }
        },
        {
          "name": "POST /api/events/publish/cv.anomaly (publish via gateway)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"test anomaly\",\n  \"severity\": \"low\"\n}" },
            "url": { "raw": "{{gw}}/api/events/publish/cv.anomaly", "host": ["{{gw}}"], "path": ["api", "events", "publish", "cv.anomaly"] }
          }
        }
      ]
    },
    {
      "name": "2. Virtual Camera (:9003)",
      "item": [
        {
          "name": "GET /health",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{camera}}/health", "host": ["{{camera}}"], "path": ["health"] } }
        },
        {
          "name": "GET /api/camera/feed",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{camera}}/api/camera/feed", "host": ["{{camera}}"], "path": ["api", "camera", "feed"] } }
        }
      ]
    },
    {
      "name": "3. NLP Chat (:9004)",
      "item": [
        {
          "name": "GET /health",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{nlp}}/health", "host": ["{{nlp}}"], "path": ["health"] } }
        },
        {
          "name": "POST /chat",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"set signal mode fuzzy\",\n  \"city\": \"chicago\"\n}" },
            "url": { "raw": "{{nlp}}/chat", "host": ["{{nlp}}"], "path": ["chat"] }
          }
        },
        {
          "name": "POST /incident",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"road closed at 5th avenue\",\n  \"city\": \"chicago\"\n}" },
            "url": { "raw": "{{nlp}}/incident", "host": ["{{nlp}}"], "path": ["incident"] }
          }
        },
        {
          "name": "POST /feedback",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"the simulation is great\",\n  \"city\": \"chicago\"\n}" },
            "url": { "raw": "{{nlp}}/feedback", "host": ["{{nlp}}"], "path": ["feedback"] }
          }
        }
      ]
    },
    {
      "name": "4. Event Bus (:9005)",
      "item": [
        {
          "name": "GET /health",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{eventbus}}/health", "host": ["{{eventbus}}"], "path": ["health"] } }
        },
        {
          "name": "GET /events",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{eventbus}}/events", "host": ["{{eventbus}}"], "path": ["events"] } }
        },
        {
          "name": "POST /publish/cv.anomaly",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"test anomaly\",\n  \"severity\": \"low\"\n}" },
            "url": { "raw": "{{eventbus}}/publish/cv.anomaly", "host": ["{{eventbus}}"], "path": ["publish", "cv.anomaly"] }
          }
        },
        {
          "name": "WS /ws (event stream)",
          "request": {
            "method": "GET",
            "header": [],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"subscribe\",\n  \"topic\": \"cv.anomaly\"\n}" },
            "url": { "raw": "ws://localhost:9005/ws", "protocol": "ws", "host": ["localhost"], "port": "9005", "path": ["ws"] }
          }
        }
      ]
    },
    {
      "name": "5. Algo Explorer (:9006)",
      "item": [
        {
          "name": "GET /health",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{algo}}/health", "host": ["{{algo}}"], "path": ["health"] } }
        },
        {
          "name": "GET /algorithms",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{algo}}/algorithms", "host": ["{{algo}}"], "path": ["algorithms"] } }
        },
        {
          "name": "POST /algorithms/toggle",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"algo_id\": \"CV-1\",\n  \"active\": false\n}" },
            "url": { "raw": "{{algo}}/algorithms/toggle", "host": ["{{algo}}"], "path": ["algorithms", "toggle"] }
          }
        }
      ]
    },
    {
      "name": "6. Dashboard (:3000)",
      "item": [
        {
          "name": "GET / (SPA)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{dashboard}}/", "host": ["{{dashboard}}"], "path": [""] } }
        },
        {
          "name": "GET /data/36_algo_matrix.json",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{dashboard}}/data/36_algo_matrix.json", "host": ["{{dashboard}}"], "path": ["data", "36_algo_matrix.json"] } }
        }
      ]
    },
    {
      "name": "7. Engine direct (:9001)",
      "item": [
        {
          "name": "WS direct (state stream)",
          "request": {
            "method": "GET",
            "header": [],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"city\",\n  \"city\": \"chicago\"\n}" },
            "url": { "raw": "ws://localhost:9001", "protocol": "ws", "host": ["localhost"], "port": "9001", "path": [""] }
          }
        }
      ]
    }
  ]
}
